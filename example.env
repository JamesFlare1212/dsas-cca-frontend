# Prebuilt image followed by Watchtower. latest tracks the default branch.
APP_IMAGE=ghcr.io/jamesflare1212/dsas-cca-frontend:latest
PORT=3040
WATCHTOWER_POLL_INTERVAL=300
WATCHTOWER_DOCKER_API_VERSION=1.44
# Private GHCR only; used with docker-compose.auth.yaml.
# WATCHTOWER_AUTH_DIR=./.watchtower-auth

# Local development and source builds only. Prebuilt images already contain this URL.
# Public, build-time configuration. Changes require rebuilding the image.
# The API must allow browser requests from your site's origin.
PUBLIC_API_BASE_URL=https://dsas-cca.jamesflare.com/v1
