{
  "name": "dsas-cca-frontend",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun vite dev --host 0.0.0.0",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview --host 0.0.0.0",
    "prepare": "bun --bun svelte-kit sync",
    "check": "bun --bun svelte-kit sync && bun scripts/check.ts",
    "test": "bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@lucide/svelte": "^1.61.0",
    "fuse.js": "^7.5.0",
    "svelte": "^5.57.2"
  },
  "packageManager": "bun@1.4.4",
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@internationalized/date": "^3.12.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@~7.0.2",
    "bits-ui": "^2.20.0",
    "cn": "^0.5.0",
    "mode-watcher": "^1.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn-svelte": "^1.7.1",
    "svelte-check": "^4.7.7",
    "svelte-sonner": "^1.2.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
